    "Timer": {
        "scope": "python",
        "prefix": "Timer",
        "body": [
            "def Timer(x, direction, randomize=bool):",
            "    if direction == 1:  # Counts from 0 to x",
            "        if randomize is True:",
            "            partial_w = random.uniform(0.001, 0.999)",
            "            deviation = (x * 1.367)",
            "            diff_w = (deviation - x)",
            "            diff = (diff_w + partial_w)",
            "            max = (x + diff)",
            "            min = (x - diff)",
            "            if min < 1:",
            "                partial = (x * 0.364)",
            "                min = (x + partial)",
            "            tot_diff = (max - min)",
            "            if tot_diff <= 3:",
            "                max += 2.539",
            "            choice = random.uniform(min, max)",
            "            w = int(choice)",
            "            f = (choice - w)",
            "            for i in range(1, w + 1):",
            "                if i <= 59:",
            "                    print(f\"{i}sec...\")",
            "                    time.sleep(1)",
            "            if f > 0:",
            "                time.sleep(f)",
            "        elif randomize is False:",
            "            z = 0",
            "            while x > 0:",
            "                z += 1",
            "                print(z)",
            "                x -= 1",
            "                time.sleep(1)",
            "    elif direction == 0:  # Counts from x to 0",
            "        if randomize is True:",
            "            partial_w = random.uniform(0.001, 0.999)",
            "            deviation = (x * 1.367)",
            "            diff_w = (deviation - x)",
            "            diff = (diff_w + partial_w)",
            "            max = (x + diff)",
            "            min = (x - diff)",
            "            if min < 1:",
            "                partial = (x * 0.364)",
            "                min = (x + partial)",
            "            tot_diff = (max - min)",
            "            if tot_diff <= 3:",
            "                max += 2.539",
            "            choice = random.uniform(min, max)",
            "            w = int(choice)",
            "            f = (choice - w)",
            "            for i in range(w, 0, -1):",
            "                print(f\"{i}sec...\")",
            "                time.sleep(1)",
            "            if f > 0:",
            "                time.sleep(f)",
            "        elif randomize is False:",
            "            while x > 0:",
            "                print(x)",
            "                x -= 1",
            "                time.sleep(1)"
        ],
        "description": "Snippet for the Timer function"
    },
